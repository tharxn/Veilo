{
  "manifest_version": 3,
  "name": "Veilo",
  "version": "0.1.9",
  "description": "On-device PII and secret redaction for popular AI chat platforms",
  "icons": {
    "16": "icons/veilo-16.png",
    "32": "icons/veilo-32.png",
    "48": "icons/veilo-48.png",
    "128": "icons/veilo-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/veilo-16.png",
      "32": "icons/veilo-32.png",
      "48": "icons/veilo-48.png"
    }
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["ocr/*", "ocr/core/*", "ocr/lang/*", "fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file://*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*"
      ],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
